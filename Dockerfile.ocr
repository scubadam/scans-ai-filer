# syntax=docker/dockerfile:1

FROM --platform=$BUILDPLATFORM golang:1.27-bookworm AS builder
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ocr-server ./cmd/ocr-server
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/ocr-server ./cmd/ocr-server

FROM alpine:3.21
RUN apk add --no-cache tesseract-ocr tesseract-ocr-data-eng \
    && adduser -D -u 65532 nonroot
COPY --from=builder /out/ocr-server /usr/local/bin/ocr-server
USER 65532:65532
EXPOSE 8085
ENTRYPOINT ["/usr/local/bin/ocr-server"]
