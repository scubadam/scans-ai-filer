# Copy to .env in the deploy/ directory and customize before running:
#   mkdir -p scans/Inbox
#   docker compose up -d

# Storage backend: "local" (host folder / NAS mount) or "gdrive"
STORAGE_PROVIDER=local
LOCAL_SCANS_DIR=./scans

# AI backend: "gemini" (paid tier recommended) or "ollama" / "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional AES-256 PDF password encryption (leave blank to disable)
PDF_PASSWORD=

# Optional ntfy push notifications
NTFY_URL=
NTFY_TOPIC=scans-filer
NTFY_TOKEN=

# Optional Home Assistant / generic JSON webhook
WEBHOOK_URL=

# Embedded Taxonomy PWA port
WEB_UI_PORT=8080
